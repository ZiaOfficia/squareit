# Copy to .env.local and fill in. None of these are required to run the site.

# Canonical origin. Override for staging so canonicals do not point at production.
NEXT_PUBLIC_SITE_URL=https://squareit.in

# Analytics — leave empty to disable the script entirely.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GTM_ID=

# Search Console meta verification token.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# Phase 2 — backend, admin panel and CMS. Not used yet.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://user:password@localhost:5432/squareit
# AUTH_SECRET=
# ADMIN_EMAIL=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM="Squareit Solutions <no-reply@squareit.in>"
# UPLOADS_BUCKET=
